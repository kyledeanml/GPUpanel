{
    "refresh-interval": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 15,
        "step": 1,
        "units": "seconds",
        "description": "Telemetry refresh interval"
    },
    "show-mini-graph": {
        "type": "checkbox",
        "default": true,
        "description": "Show live neon Cairo mini-graph on the panel"
    },
    "graph-width": {
        "type": "spinbutton",
        "default": 54,
        "min": 32,
        "max": 140,
        "step": 4,
        "units": "px",
        "description": "Panel mini-graph width"
    },
    "show-vram-on-panel": {
        "type": "checkbox",
        "default": true,
        "description": "Show VRAM usage in panel label"
    },
    "show-temp-on-panel": {
        "type": "checkbox",
        "default": true,
        "description": "Show GPU temperature in panel label"
    }
}
